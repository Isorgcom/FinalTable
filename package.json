  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "socket.io-client": "^4.8.3"
