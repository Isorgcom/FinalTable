# Server port (default: 2026)
PORT=2026

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Save data directory (default: /app/data in Docker, ./data locally)
SAVE_DIR=./data

# Optional npm registry mirror for Docker builds on slow or self-hosted networks.
# Example: https://registry.npmmirror.com
NPM_REGISTRY=

# Tournaments.
# How many may exist at once, including finished ones still showing standings.
MAX_TOURNAMENTS=8
# A finished tournament keeps its standings listed this long (ms).
TOURNAMENT_FINISHED_TTL_MS=600000

# ── The database ────────────────────────────────────────────────────────────
# Everything FinalTable keeps lives in a MariaDB of its own, started beside the
# server by docker-compose.yml. These two have no defaults on purpose: compose
# refuses to start without them rather than bringing up a database anybody who
# has read this file can open.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# The rest only if you are not using the compose file's database.
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=finaltable
# DB_USER=finaltable
# How much of itself MariaDB gives to caching, and the ceiling on the
# container. Small on purpose - this schema is tiny - and worth raising on a
# machine with room.
# DB_BUFFER_POOL=64M
# DB_MEM_LIMIT=320m
# A game's hands, for the players who were in it: how many a running game keeps,
# how long they are kept afterwards, and how many games' worth the server holds.
HAND_HISTORY_MAX=500
HAND_HISTORY_TTL_MS=2592000000
HAND_HISTORY_MAX_GAMES=200
# Mail, which is how an account is made: a link proves the address at sign-up,
# and another sets a new password when one is forgotten. Both of the first two
# are needed - a link has to point somewhere, and the server has to be able to
# send one - and without them nobody can sign up here at all. A server with no
# GameNight pairing either has no way in, and says so at boot.
#
# PUBLIC_URL is the address players actually reach this server on, which is
# what links are built against. Behind a proxy it is the proxy's address, not
# the container's.
PUBLIC_URL=https://finaltable.example.com
#
# SMTP_URL is the outgoing server, as a URL. smtps:// is TLS from the first
# byte (usually port 465); smtp:// is plain or STARTTLS (usually 587). A
# password with @ : / or # in it must be percent-encoded.
#
#   smtps://user%40example.com:app-password@smtp.gmail.com:465
#   smtp://apikey:SG.xxxx@smtp.sendgrid.net:587
#   smtp://192.168.1.10:25                  (a relay that needs no login)
SMTP_URL=
#
# What the mail says it is from. Some relays insist this matches the account
# the SMTP_URL signs in as.
MAIL_FROM=FinalTable <no-reply@example.com>
#
# MAIL_TRANSPORT=log writes the whole message, link and all, to the server log
# instead of sending it - `docker logs finaltable | grep mail_logged` is then
# the inbox. It is for development and never for a server that can send: it
# takes precedence over SMTP_URL, so a box that has both sends nothing. Any
# other value, or none, means send it properly.
MAIL_TRANSPORT=
# A field holds when nobody with chips is connected. It is written off after
# this long with nobody back (ms). Six hours: holding costs nothing.
TOURNAMENT_ZOMBIE_HOLD_MS=21600000
# A disconnected host loses the host role to the next connected human after this (ms).
HOST_TRANSFER_GRACE_MS=120000
# How long a seat that is sitting out pauses before it checks or folds (ms),
# divided by the table speed multiplier.
AUTO_TURN_DELAY_MS=600
# Pacing. A betting round closing and the next street arriving in the same
# frame is too fast to follow, so the table holds a beat between them, and
# another between one hand and the next. The hand beat is rounded up to the
# director's tick, so the real gap is this plus up to 1.2s.
STREET_PAUSE_MS=1600
HAND_PAUSE_MS=3500

# API rate limiting for self-hosted deployments.
HTTP_RATE_LIMIT=240
HTTP_RATE_WINDOW_MS=60000

# The account that runs this server, by name. There is no admin password any
# more: the Admin page and ending a running tournament from the table menu
# belong to an account with the administrator role, and the first account made
# on a fresh server gets it without anybody setting anything.
#
# This is for the two cases where that is not the answer - a stranger signed
# up before you did, or the only administrator has lost both their password
# and their address. It is applied on every boot and never takes the role
# away, so leaving it set is harmless. A name nobody here has logs an error
# and changes nothing.
# ADMIN_PROMOTE=Bryce

# Sign in with GameNight. The usual way to pair is the lobby's Admin page,
# which an administrator opens from the corner menu: enter the GameNight
# address there and the key is fetched and saved to the database. These three exist for a headless
# setup: they seed that pairing the first time the server boots with nothing
# saved, and after that the saved pairing wins. GameNight registers this
# server under Site Settings > Connected Apps and shows all three ready to
# paste. Both unset means no seed; one without the other, or a key that does
# not parse, stops the server from starting rather than leaving a button that
# does nothing. The key is a PEM on one line, with \n for each line break.
# GAMENIGHT_URL=https://gamenight.example
# GAMENIGHT_AUDIENCE=finaltable
# GAMENIGHT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----"

# Node's heap ceiling in MB, and the container's memory limit. The defaults are
# sized for a handful of tables. A large field needs both raised together: at
# twenty-plus tables the heap climbs past the default and the process dies with
# "JavaScript heap out of memory". Keep the heap comfortably under the limit,
# because the process needs room outside the heap as well.
NODE_HEAP_MB=384
MEM_LIMIT=512m

# Set when the app runs behind a reverse proxy that terminates TLS, so Express
# reads the client address from X-Forwarded-For instead of logging every request
# as the proxy. Leave unset for a direct LAN or NAS deployment.
# TRUST_PROXY=true

# Origins allowed to open a socket. Defaults to * , which is what a self-hosted
# table on a LAN wants; name the origins if it is reachable from the internet.
# CORS_ORIGIN=https://test.example.com

# Chat, on by default. Off removes the surface rather than hiding the box: the
# socket events are not registered and no buffer is allocated.
# CHAT_ENABLED=false

# How many lines a room keeps. A room is a table, or the waiting room before
# there are tables, and this is what a reload, a rejoin or a restart replays.
# It is also the only thing bounding what chat costs, in memory and on disk: a
# line is about 400 bytes, so a hundred of them per table is well under a
# megabyte across a large field. Set to 0 to keep chat working but keep none of
# it - nothing is written to data/chat/ and nobody gets a backlog.
# CHAT_HISTORY=100

# The longest single message, in characters rather than bytes, so an emoji
# counts as one.
# CHAT_MAX_LEN=200

# The rate limit, per socket: this many messages inside this window. Enough to
# hold a conversation, not enough to flood a table.
# CHAT_RATE=4
# CHAT_RATE_WINDOW_MS=10000

# Reactions: a strip of a few emoji a seated player can throw at the table
# without typing, floating over their chair for a moment. They go to the same
# room as chat and past the same host mute, but are not kept anywhere. Off
# removes the strip and the event, the same way CHAT_ENABLED does. The rate is
# tighter than chat's, because a reaction costs one tap.
# REACTIONS_ENABLED=false
# REACTION_RATE=3
# REACTION_RATE_WINDOW_MS=10000
