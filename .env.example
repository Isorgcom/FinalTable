# Server port (default: 2026)
PORT=2026

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Save data directory (default: /app/data in Docker, ./data locally)
SAVE_DIR=./data

# Optional npm registry mirror for Docker builds on slow or self-hosted networks.
# Example: https://registry.npmmirror.com
NPM_REGISTRY=

# Tournaments.
# How many may exist at once, including finished ones still showing standings.
MAX_TOURNAMENTS=8
# A finished tournament keeps its standings listed this long (ms).
TOURNAMENT_FINISHED_TTL_MS=600000
# A running tournament with nobody connected is torn down after this (ms).
TOURNAMENT_ABANDON_GRACE_MS=120000
# A disconnected host loses the host role to the next connected human after this (ms).
HOST_TRANSFER_GRACE_MS=120000
# How long a seat that is sitting out pauses before it checks or folds (ms),
# divided by the table speed multiplier.
AUTO_TURN_DELAY_MS=600
# Pacing. A betting round closing and the next street arriving in the same
# frame is too fast to follow, so the table holds a beat between them, and
# another between one hand and the next. The hand beat is rounded up to the
# director's tick, so the real gap is this plus up to 1.2s.
STREET_PAUSE_MS=1600
HAND_PAUSE_MS=3500

# API rate limiting for self-hosted deployments.
HTTP_RATE_LIMIT=240
HTTP_RATE_WINDOW_MS=60000

# Password for the operator controls: the Operator page in the lobby, and
# ending a running tournament from the table menu. Unset or empty means those
# controls do not exist at all — there is no default password, and with no
# password there is no way in to set one, which is why this is how a server
# gets its first. It can be changed from the Operator page afterwards, and the
# changed one is kept (hashed) in data/settings.json and wins from then on;
# remove `adminPassword` from that file to fall back to this. Note that this
# server is meant to be reachable over plain HTTP on a LAN, so the password
# crosses the wire as typed: it guards against the other people at the table,
# not against somebody who can watch the network.
ADMIN_PASSWORD=

# Sign in with GameNight. The usual way to pair is the lobby's Operator page
# (behind ADMIN_PASSWORD): enter the GameNight address there and the key is
# fetched and saved to data/settings.json. These three exist for a headless
# setup: they seed that pairing the first time the server boots with nothing
# saved, and after that the saved pairing wins. GameNight registers this
# server under Site Settings > Connected Apps and shows all three ready to
# paste. Both unset means no seed; one without the other, or a key that does
# not parse, stops the server from starting rather than leaving a button that
# does nothing. The key is a PEM on one line, with \n for each line break.
# GAMENIGHT_URL=https://gamenight.example
# GAMENIGHT_AUDIENCE=finaltable
# GAMENIGHT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----"

# Node's heap ceiling in MB, and the container's memory limit. The defaults are
# sized for a handful of tables. A large field needs both raised together: at
# twenty-plus tables the heap climbs past the default and the process dies with
# "JavaScript heap out of memory". Keep the heap comfortably under the limit,
# because the process needs room outside the heap as well.
NODE_HEAP_MB=384
MEM_LIMIT=512m

# Set when the app runs behind a reverse proxy that terminates TLS, so Express
# reads the client address from X-Forwarded-For instead of logging every request
# as the proxy. Leave unset for a direct LAN or NAS deployment.
# TRUST_PROXY=true

# Origins allowed to open a socket. Defaults to * , which is what a self-hosted
# table on a LAN wants; name the origins if it is reachable from the internet.
# CORS_ORIGIN=https://test.example.com

# Chat, on by default. Off removes the surface rather than hiding the box: the
# socket events are not registered and no buffer is allocated, the same way an
# empty ADMIN_PASSWORD removes the admin controls entirely.
# CHAT_ENABLED=false

# How many lines a room keeps. A room is a table, or the waiting room before
# there are tables, and this is what a reload, a rejoin or a restart replays.
# It is also the only thing bounding what chat costs, in memory and on disk: a
# line is about 400 bytes, so a hundred of them per table is well under a
# megabyte across a large field. Set to 0 to keep chat working but keep none of
# it - nothing is written to data/chat/ and nobody gets a backlog.
# CHAT_HISTORY=100

# The longest single message, in characters rather than bytes, so an emoji
# counts as one.
# CHAT_MAX_LEN=200

# The rate limit, per socket: this many messages inside this window. Enough to
# hold a conversation, not enough to flood a table.
# CHAT_RATE=4
# CHAT_RATE_WINDOW_MS=10000
