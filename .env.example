# Server port (default: 2026)
PORT=2026

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Save data directory (default: /app/data in Docker, ./data locally)
SAVE_DIR=./data

# Optional npm registry mirror for Docker builds on slow or self-hosted networks.
# Example: https://registry.npmmirror.com
NPM_REGISTRY=

# Tournaments.
# How many may exist at once, including finished ones still showing standings.
MAX_TOURNAMENTS=8
# A finished tournament keeps its standings listed this long (ms).
TOURNAMENT_FINISHED_TTL_MS=600000
# A running tournament with nobody connected is torn down after this (ms).
TOURNAMENT_ABANDON_GRACE_MS=120000
# A disconnected host loses the host role to the next connected human after this (ms).
HOST_TRANSFER_GRACE_MS=120000
# How long a seat that is sitting out pauses before it checks or folds (ms),
# divided by the table speed multiplier.
AUTO_TURN_DELAY_MS=600
# Pacing. A betting round closing and the next street arriving in the same
# frame is too fast to follow, so the table holds a beat between them, and
# another between one hand and the next. The hand beat is rounded up to the
# director's tick, so the real gap is this plus up to 1.2s.
STREET_PAUSE_MS=1600
HAND_PAUSE_MS=3500

# API rate limiting for self-hosted deployments.
HTTP_RATE_LIMIT=240
HTTP_RATE_WINDOW_MS=60000

# Password for the operator controls in the table menu: unlock, then cancel a
# tournament that is already running. Unset or empty means those controls do
# not exist at all — there is no default password. Note that this server is
# meant to be reachable over plain HTTP on a LAN, so the password crosses the
# wire as typed: it guards against the other people at the table, not against
# somebody who can watch the network.
ADMIN_PASSWORD=
